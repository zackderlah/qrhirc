      "refersTo": "button-primary",
      "description": "Default research or enquiry action.",
      "html": "<a href=\"#research\" class=\"ds-button\">Explore our research <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M7 17 17 7M7 7h10v10\"/></svg></a>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:space-between;gap:28px;padding:17px 22px;border:0;border-radius:var(--radius,4px);font:600 14px/1.5 Manrope,sans-serif;text-decoration:none;transition:background .2s,color .2s}.ds-button svg{transition:transform .2s}.ds-button:hover svg{transform:translate(2px,-2px)}.ds-button:focus-visible{outline:3px solid var(--accent,#b44b26);outline-offset:5px}@media(prefers-reduced-motion:reduce){.ds-button,.ds-button svg{transition:none}}.ds-button{background:var(--ink,#172b2a);color:#fff}.ds-button:hover{background:var(--accent,#b44b26)}"
