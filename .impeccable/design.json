      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:space-between;gap:28px;padding:17px 22px;border:0;border-radius:var(--radius,4px);font:600 14px/1.5 Manrope,sans-serif;text-decoration:none;transition:background .2s,color .2s}.ds-button svg{transition:transform .2s}.ds-button:hover svg{transform:translate(2px,-2px)}.ds-button:focus-visible{outline:3px solid var(--accent,#b44b26);outline-offset:5px}@media(prefers-reduced-motion:reduce){.ds-button,.ds-button svg{transition:none}}.ds-button{background:#e9eddf;color:#233c31;min-width:185px}.ds-button:hover{background:white}"
